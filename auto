#!/bin/bash
# Universal framework command - resolves CONFIG_PATH and discovers/executes any job
# Usage: CONFIG_PATH=~/automation-monorepo-config dedup-wallet-today [args...]

set -e

# Get the actual command being run
COMMAND="${COMMAND:-$(basename "$0")}"

# If called with arguments, treat first arg as command
if [ "$#" -gt 0 ] && [ "$1" != "-"* ]; then
  COMMAND="$1"
  shift
fi

# Resolve CONFIG_PATH (defaults to ~/automation-monorepo-config)
if [ -z "$CONFIG_PATH" ]; then
  CONFIG_PATH="$HOME/automation-monorepo-config"
fi

# Expand ~ if needed
CONFIG_PATH="${CONFIG_PATH/\~/$HOME}"

# Verify config exists
if [ ! -d "$CONFIG_PATH" ]; then
  echo "❌ CONFIG_PATH not found: $CONFIG_PATH"
  echo "Set CONFIG_PATH=~/automation-monorepo-config and try again"
  exit 1
fi

# Discover the command script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"

# Search locations for command script
COMMAND_SCRIPT=""
for search_dir in \
  "$REPO_ROOT/packs/expense-domain/sources/wallet/scripts" \
  "$REPO_ROOT/packs/expense-domain/sources/gmail/scripts" \
  "$REPO_ROOT/scripts"; do

  if [ -f "$search_dir/$COMMAND.sh" ]; then
    COMMAND_SCRIPT="$search_dir/$COMMAND.sh"
    break
  fi
done

if [ -z "$COMMAND_SCRIPT" ]; then
  echo "❌ Command not found: $COMMAND"
  echo "Searched:"
  echo "  - $REPO_ROOT/packs/*/sources/*/scripts/$COMMAND.sh"
  echo "  - $REPO_ROOT/scripts/$COMMAND.sh"
  exit 1
fi

# Load credentials from config
for domain in wallet gmail; do
  DOMAIN_CONFIG="$CONFIG_PATH/config/$domain/config.yaml"
  if [ -f "$DOMAIN_CONFIG" ]; then
    if grep -q "API_TOKEN:" "$DOMAIN_CONFIG" 2>/dev/null; then
      # Convert domain to uppercase (portable: works in sh/zsh/bash)
      DOMAIN_UPPER=$(echo "$domain" | tr '[:lower:]' '[:upper:]')
      TOKEN_VAR="${DOMAIN_UPPER}_API_TOKEN"
      TOKEN_VALUE=$(grep "${TOKEN_VAR}:" "$DOMAIN_CONFIG" | cut -d'"' -f2)
      eval "export ${TOKEN_VAR}='${TOKEN_VALUE}'"
    fi
  fi
done

# Set up framework environment
export CONFIG_PATH="$CONFIG_PATH"
export AUTO_DATA_DIR="$CONFIG_PATH/data"
export REPO_ROOT="$REPO_ROOT"

# Execute the command
exec "$COMMAND_SCRIPT" "$@"
