#!/usr/bin/env python3
"""auto — the automation-framework CLI (pack-aware).

Every script is a "job": a folder with a manifest.yaml. Jobs live in *packs*;
a *workspace* mounts packs via packs.yaml. This tool discovers jobs across all
mounted packs and does everything else: run, scaffold, schedule, document,
health-check, and enforce the private/shared/public visibility rules.

Usage:
  auto list [--json] [--visibility private|shared|public]
  auto packs
  auto search <term>
  auto run <id> [--ai <name>] [-- extra args]
  auto orchestrate [<name>]    # run (or list, if no name) a multi-step pipeline from orchestrator/
  auto new
  auto catalog                 # workspace catalog (all packs)
  auto share [<pack>]          # write a shareable catalog of a pack's non-private jobs
  auto schedule sync [--dry-run]
  auto log "<message>"
  auto doctor                  # validate manifests + enforce visibility rules
  auto bootstrap
  auto serve [--port N]        # local dashboard: run jobs/pipelines one-click, watch live logs,
                               #   plus packs, config status, jobs, command help (needs tmux)

run / orchestrate / serve / schedule additionally REQUIRE (ADR 0019):
  --data-dir <path>            # or AUTO_DATA_DIR   — must contain state/ and config/
  --config-dir <path>          # or AUTO_CONFIG_DIR — must contain ai/ or a pack dir
Inspection commands (list, packs, doctor, catalog, config, search) need neither.
"""
from __future__ import annotations
import argparse, html, json, os, platform, re, shlex, socket, subprocess, sys, textwrap, threading, datetime, shutil, time
from pathlib import Path

try:
    import yaml
except ImportError:
    # Name the interpreter that's actually running. `auto` is launched via
    # `exec python3`, so with a venv active — or nix/pyenv on PATH — the python3
    # that wins here can easily differ from the one `pip` writes to. Without
    # this, the old message ("pip install pyyaml") sent you round a loop: pip
    # reports "already satisfied" for a *different* interpreter every time.
    sys.exit(
        "PyYAML is required, and this interpreter cannot import it:\n"
        f"  interpreter : {sys.executable}\n"
        f"  version     : {sys.version.split()[0]}\n"
        f"  venv active : {os.environ.get('VIRTUAL_ENV') or '(none)'}\n"
        "\n"
        "Install it FOR THIS INTERPRETER:\n"
        f"  {sys.executable} -m pip install pyyaml\n"
        "     (add --break-system-packages if it refuses)\n"
        "\n"
        "If that says 'already satisfied', a different python3 is winning on\n"
        "PATH than the one pip targets — check `which -a python3`, then either\n"
        "deactivate the venv or put the right one first, e.g.\n"
        "  PATH=\"/opt/homebrew/bin:$PATH\" ./auto ...")

FRAMEWORK = Path(__file__).resolve().parent.parent          # .../framework
VISIBILITIES = ("private", "shared", "public")


# ---------- workspace & packs ------------------------------------------------
def find_workspace() -> Path:
    """Workspace root = nearest ancestor containing packs.yaml."""
    env = os.environ.get("AUTO_WORKSPACE")
    start = Path(env) if env else Path.cwd()
    for d in [start, *start.parents]:
        if (d / "packs.yaml").exists():
            return d
    return FRAMEWORK.parent   # fallback: framework usually sits inside the workspace

WS = find_workspace()
GEN = WS / "schedules" / "generated"
WORKLOG = WS / "docs" / "worklog"
ORCH_DIR = WS / "orchestrator"

# DATA and CONFIG_DIR are NOT authoritative here (spec 005 rev. 2, FR-014/FR-015).
# They start as the conventional locations purely so inspection commands that
# never touch them can still import this module, and are REPLACED by
# resolve_workspace_dirs() from an explicit --data-dir/--config-dir option or
# the AUTO_DATA_DIR/AUTO_CONFIG_DIR env var before any command that does real
# work runs. A command that reads these without having resolved them first is a
# bug: running against a silently-guessed directory is exactly what this
# feature exists to prevent.
DATA = WS / "data"
CONFIG_DIR = WS / "config"


# ---------- workspace dirs (explicit + validated, spec 005 rev. 2) -----------
# Expected children, used to tell a real workspace directory from a
# plausible-but-wrong one (a home directory, an unrelated project, an empty
# folder). These are the paths the code actually reads: DATA/state/*.sqlite,
# DATA/config/expense-rules.yaml, CONFIG_DIR/ai/<name>.yaml,
# CONFIG_DIR/<pack>/config.yaml.
DATA_DIR_REQUIRED_CHILDREN = ("state", "config")


def _dir_basic_problem(path: Path, label: str) -> str | None:
    if not path.exists():
        return f"{label} {path} does not exist"
    if not path.is_dir():
        return f"{label} {path} is not a directory"
    return None


def validate_data_dir(path: Path) -> tuple[bool, str]:
    """A workspace data directory must exist and hold the run-state and
    shared-config subdirectories. Returns (ok, reason)."""
    problem = _dir_basic_problem(path, "data directory")
    if problem:
        return False, problem
    missing = [c for c in DATA_DIR_REQUIRED_CHILDREN if not (path / c).is_dir()]
    if missing:
        return False, (f"data directory {path} is missing "
                       f"{', '.join(repr(m) + '/' for m in missing)} — "
                       f"expected a workspace data directory containing "
                       f"{', '.join(c + '/' for c in DATA_DIR_REQUIRED_CHILDREN)}")
    return True, ""


def validate_config_dir(path: Path) -> tuple[bool, str]:
    """A workspace config directory must exist and hold either the AI-profile
    directory or at least one mounted pack's config directory."""
    problem = _dir_basic_problem(path, "config directory")
    if problem:
        return False, problem
    if (path / "ai").is_dir():
        return True, ""
    try:
        pack_names = [p["name"] for p in load_packs()]
    except Exception:
        pack_names = []
    if any((path / n).is_dir() for n in pack_names):
        return True, ""
    return False, (f"config directory {path} contains neither 'ai/' nor any "
                   f"mounted pack's directory ({', '.join(pack_names) or 'no packs mounted'}) — "
                   f"expected a workspace config directory")


def _resolve_one(opt: str, env_name: str, label: str, validator) -> Path:
    """Resolve one directory: explicit option wins over env var (FR-016).
    Exits with an actionable message on any problem (FR-018)."""
    raw = opt or os.environ.get(env_name, "")
    if not raw:
        sys.exit(f"{label} directory is required but was not supplied.\n"
                 f"  pass --{label}-dir <path>, or set {env_name}\n"
                 f"  e.g. --{label}-dir ./{label}    (or: export {env_name}=\"$PWD/{label}\")")
    path = Path(raw).expanduser().resolve()
    ok, reason = validator(path)
    if not ok:
        sys.exit(f"{reason}\n"
                 f"  supplied via {'--' + label + '-dir' if opt else env_name}: {raw}")
    return path


def resolve_workspace_dirs(data_opt: str = "", config_opt: str = "") -> tuple[Path, Path]:
    """Bind DATA and CONFIG_DIR from explicit sources, validating first.
    Called only for commands that do real work — inspection commands never
    resolve, so they stay usable for diagnosing a bad configuration (FR-019)."""
    global DATA, CONFIG_DIR
    DATA = _resolve_one(data_opt, "AUTO_DATA_DIR", "data", validate_data_dir)
    CONFIG_DIR = _resolve_one(config_opt, "AUTO_CONFIG_DIR", "config", validate_config_dir)
    return DATA, CONFIG_DIR

def load_yaml(p: Path) -> dict:
    with open(p) as f:
        return yaml.safe_load(f) or {}

def load_packs() -> list[dict]:
    pf = WS / "packs.yaml"
    if not pf.exists():
        return []
    packs = []
    for p in load_yaml(pf).get("packs", []):
        p["_path"] = WS / p["path"]
        packs.append(p)
    return packs

def pack_default_vis(pack: dict) -> str:
    pj = pack["_path"] / "pack.yaml"          # pack.yaml wins over the registry
    if pj.exists():
        v = load_yaml(pj).get("default_visibility")
        if v:
            return v
    return pack.get("default_visibility", "private")

def pack_config_dir(pack_name: str) -> Path:
    """Workspace-local, git-ignored dir holding a pack's real config + secrets.
    Rooted at the resolved CONFIG_DIR (spec 005 rev. 2), not a derived path."""
    return CONFIG_DIR / pack_name

def load_pack_config(pack: dict):
    """Return (env_dict, files_list, config_dir) for a pack.

    Contract: the pack ships `config.sample.yaml` at its root declaring the env
    keys it reads and the secret files it needs. The workspace overrides values
    in `config/<pack>/config.yaml` (git-ignored). Env precedence, low→high:
    sample defaults < workspace override < the ambient shell environment.
    """
    sample = pack["_path"] / "config.sample.yaml"
    override = pack_config_dir(pack["name"]) / "config.yaml"
    env, files = {}, []
    if sample.exists():
        s = load_yaml(sample)
        env.update({str(k): "" if v is None else str(v) for k, v in (s.get("env") or {}).items()})
        files = list(s.get("files") or [])
    if override.exists():
        o = load_yaml(override)
        env.update({str(k): "" if v is None else str(v) for k, v in (o.get("env") or {}).items()})
    return env, files, pack_config_dir(pack["name"])


# ---------- AI provider profiles (ADR 0015) ----------------------------------
def ai_profile_dir() -> Path:
    """Workspace-local, git-ignored dir holding named AI provider profiles,
    shared by every pack — see config/ai/README.md. Rooted at the resolved
    CONFIG_DIR (spec 005 rev. 2), not a derived path."""
    return CONFIG_DIR / "ai"

def load_ai_profile(name: str) -> dict:
    """Load and validate config/ai/<name>.yaml: provider, api_key (required),
    optional model / api_base. Exits with a clear message on any problem —
    an explicit `--ai <name>` should never fail silently or fall through to
    some other credential source."""
    path = ai_profile_dir() / f"{name}.yaml"
    if not path.exists():
        sys.exit(f"AI profile '{name}' not found at {path.relative_to(WS)}\n"
                  f"  copy an example: cp config/ai/deepseek.example.yaml config/ai/{name}.yaml")
    p = load_yaml(path)
    provider = str(p.get("provider") or "").strip().lower()
    api_key = str(p.get("api_key") or "")
    if not provider:
        sys.exit(f"AI profile '{name}' ({path.relative_to(WS)}): missing required field 'provider'")
    if provider not in ("deepseek", "claude", "anthropic"):
        sys.exit(f"AI profile '{name}' ({path.relative_to(WS)}): unsupported provider '{provider}' "
                  f"(want \"deepseek\" or \"claude\")")
    if not api_key:
        sys.exit(f"AI profile '{name}' ({path.relative_to(WS)}): missing required field 'api_key'")
    return {"provider": provider, "api_key": api_key,
            "model": str(p.get("model") or ""), "api_base": str(p.get("api_base") or "")}

def ai_profile_env(name: str) -> dict:
    """Map a named AI profile to the env vars provider clients already read
    (DEEPSEEK_API_KEY/DEEPSEEK_MODEL/DEEPSEEK_API_BASE, or the ANTHROPIC_*
    equivalents), plus AI_PROVIDER. Any pack whose code already reads those
    (as packs/gmail did before ADR 0015 existed) picks this up with zero
    per-pack code — that's the point: the profile lives once, `auto run`
    injects it into whichever job asked for it via --ai <name>."""
    prof = load_ai_profile(name)
    provider = prof["provider"]
    env = {"AI_PROVIDER": "claude" if provider in ("claude", "anthropic") else "deepseek"}
    if provider == "deepseek":
        env["DEEPSEEK_API_KEY"] = prof["api_key"]
        if prof["model"]:
            env["DEEPSEEK_MODEL"] = prof["model"]
        if prof["api_base"]:
            env["DEEPSEEK_API_BASE"] = prof["api_base"]
    else:  # claude / anthropic
        env["ANTHROPIC_API_KEY"] = prof["api_key"]
        if prof["model"]:
            env["ANTHROPIC_MODEL"] = prof["model"]
        if prof["api_base"]:
            env["ANTHROPIC_API_BASE"] = prof["api_base"]
    return env


# ---------- jobs -------------------------------------------------------------
def load_jobs() -> list[dict]:
    jobs = []
    for pack in load_packs():
        jroot = pack["_path"] / "jobs"
        if not jroot.exists():
            continue
        dvis = pack_default_vis(pack)
        for mp in sorted(jroot.rglob("manifest.yaml")):
            try:
                m = load_yaml(mp)
            except Exception as e:
                print(f"! bad manifest {mp}: {e}", file=sys.stderr); continue
            m["_dir"] = mp.parent
            m["_pack"] = pack["name"]
            m["_packpath"] = pack["_path"]
            m["_visibility"] = m.get("visibility") or dvis
            jobs.append(m)
    return jobs

def get_job(job_id: str) -> dict:
    for j in load_jobs():
        if j.get("id") == job_id:
            return j
    sys.exit(f"no job with id '{job_id}'  (try: auto list)")

def this_os() -> str:
    s = platform.system().lower()
    return {"darwin": "macos", "windows": "windows"}.get(s, "linux")

def machines() -> list[dict]:
    mf = WS / "machines.yaml"
    return load_yaml(mf).get("machines", []) if mf.exists() else []

def current_machine() -> dict | None:
    host = os.environ.get("AUTO_MACHINE_ID") or socket.gethostname()
    for m in machines():
        if host in (m.get("id"), m.get("hostname")):
            return m
    return None

def job_runs_here(j: dict, mach: dict | None) -> bool:
    ro = j.get("runs_on", {}) or {}
    if this_os() not in ro.get("os", ["macos", "linux", "windows"]):
        return False
    want = ro.get("machines", ["any"])
    return "any" in want or bool(mach and mach.get("id") in want)


# ---------- commands ---------------------------------------------------------
def cmd_packs(args):
    ps = load_packs()
    if not ps:
        print("no packs registered — see packs.yaml"); return
    for p in ps:
        exists = "ok" if p["_path"].exists() else "MISSING"
        print(f"{p['name']:<12} vis:{pack_default_vis(p):<7} writable:{str(p.get('writable', False)):<5} {exists}  {p['path']}")

def cmd_list(args):
    jobs = load_jobs()
    if args.visibility:
        jobs = [j for j in jobs if j["_visibility"] == args.visibility]
    if getattr(args, "json", False):
        import json
        print(json.dumps([{k: v for k, v in j.items() if not k.startswith("_")} | {"pack": j["_pack"], "visibility": j["_visibility"]} for j in jobs], indent=2, default=str))
        return
    if not jobs:
        print("no jobs yet — create one with:  auto new"); return
    w = max((len(j.get("id", "")) for j in jobs), default=2)
    for j in sorted(jobs, key=lambda x: (x["_pack"], x.get("id", ""))):
        sch = j.get("schedule") or {}
        when = sch.get("cron") if sch.get("enabled") else "(manual)"
        print(f"{j.get('id',''):<{w}}  {j['_pack']:<8} {j['_visibility']:<7} {j.get('language',''):<6} {when or '(none)':<12} {j.get('name','')}")

def cmd_search(args):
    t = args.term.lower()
    for j in load_jobs():
        hay = " ".join(str(j.get(k, "")) for k in ("id", "name", "description", "category")) + " " + " ".join(j.get("tags", []))
        if t in hay.lower():
            print(f"{j.get('id')}  [{j['_pack']}/{j['_visibility']}]  —  {j.get('name')}")

def _link_pack_files(files, cfg_dir: Path, workdir: Path):
    """Make a pack's declared secret files available in the workdir via symlink,
    so file-based apps (that read e.g. ./credentials.json) find them. The real
    files live in the git-ignored workspace config dir; the symlink also lets the
    app WRITE through (e.g. token.json) so state persists across re-clones."""
    for name in files:
        target = cfg_dir / name
        link = workdir / name
        try:
            if link.is_symlink():
                link.unlink()
            elif link.exists():
                print(f"   (config) {name} already a real file in workdir — leaving it"); continue
            link.symlink_to(target)   # may be dangling (e.g. token.json created on first run)
        except OSError as e:
            print(f"   (config) could not link {name}: {e}")

def execute_job(job_id: str, extra_args: list[str] | None = None, ai: str = "",
                 timeout_override: int | None = None) -> tuple[int, float]:
    """Run one job to completion and return (returncode, duration_seconds).
    This is the shared execution core: `cmd_run` calls it once for `auto run`,
    and `cmd_orchestrate` calls it once per step attempt/iteration — the two
    share this function so a step with no orchestration controls set behaves
    byte-for-byte like `auto run` (spec FR-016), not just similarly."""
    extra_args = extra_args or []
    j = get_job(job_id)
    pack = next(p for p in load_packs() if p["name"] == j["_pack"])
    cfg_env, cfg_files, cfg_dir = load_pack_config(pack)
    ai_env = ai_profile_env(ai) if ai else {}
    # env precedence: pack sample defaults < workspace override < ambient shell env
    # < --ai <name> (ADR 0015 — the most specific, explicitly-named choice wins)
    env = {**cfg_env, **os.environ, **ai_env,
           "AUTO_DATA_DIR": str(DATA), "AUTO_WORKSPACE": str(WS),
           "AUTO_JOB_ID": j["id"], "AUTO_PACK": j["_pack"],
           "AUTO_PACK_CONFIG_DIR": str(cfg_dir)}
    if ai_env:
        print(f"   (ai) profile '{ai}' loaded — provider: {ai_env.get('AI_PROVIDER')}")
    timeout = timeout_override or (j.get("runtime") or {}).get("timeout_seconds", 600)
    # workdir defaults to the job folder; app-backed jobs set it relative to the pack root
    workdir = j["_dir"]
    if j.get("workdir"):
        workdir = (j["_packpath"] / j["workdir"]).resolve()
    if cfg_files and cfg_dir.exists():
        _link_pack_files(cfg_files, cfg_dir, workdir)
    if j.get("exec"):
        # app-backed job: run an explicit shell command in workdir (e.g. "go run . discover")
        cmd = j["exec"] + (" " + " ".join(extra_args) if extra_args else "")
        shell = True; show = cmd
    else:
        # script job: run a single entrypoint file with the language runner
        entry = j["_dir"] / j.get("entrypoint", "")
        if not entry.exists():
            sys.exit(f"entrypoint not found: {entry}")
        runner = {"python": [sys.executable], "node": ["node"], "bash": ["bash"], "go": ["go", "run"]}.get(j.get("language", "bash"), ["bash"])
        cmd = runner + [str(entry)] + extra_args
        shell = False; show = " ".join(cmd)
    start = datetime.datetime.now()
    print(f">> running {j['id']} [{j['_pack']}] in {workdir}: {show}")
    _emit_step_marker(j["id"], "start")
    try:
        rc = subprocess.run(cmd, env=env, timeout=timeout, cwd=str(workdir), shell=shell).returncode
    except subprocess.TimeoutExpired:
        rc = 124; print(f"!! timed out after {timeout}s")
    dur = (datetime.datetime.now() - start).total_seconds()
    print(f"<< {j['id']} exited {rc} in {dur:.1f}s")
    _emit_step_marker(j["id"], "end", rc)
    return rc, dur


# Step counter for the dashboard's step-level progress. Only ever advanced
# under a dashboard run — see _emit_step_marker.
_STEP_SEQ = [0]


def _emit_step_marker(job_id: str, event: str, rc: int | None = None):
    """Emit a machine-readable step marker, but ONLY when running under the
    dashboard (AUTO_RUN_AUDIT_ID set). A plain terminal `auto run` /
    `auto orchestrate` prints exactly what it always did — that byte-for-byte
    sameness is what lets a UI-launched run be considered equivalent to a
    hand-typed one. The dashboard's wrapper strips these lines from the log.
    """
    if not os.environ.get("AUTO_RUN_AUDIT_ID"):
        return
    idx = _STEP_SEQ[0]
    if event == "end":
        _STEP_SEQ[0] += 1
    line = f"{STEP_MARKER} idx={idx} job={job_id} event={event}"
    if rc is not None:
        line += f" rc={rc}"
    print(line, flush=True)

def cmd_run(args):
    j = get_job(args.id)
    rc, dur = execute_job(args.id, args.extra, getattr(args, "ai", ""))
    _record_run(j["id"], rc, dur)
    sys.exit(rc)

def _record_run(job_id, rc, dur):
    try:
        import sqlite3
        db = DATA / "state" / "runs.sqlite"; db.parent.mkdir(parents=True, exist_ok=True)
        c = sqlite3.connect(db)
        c.execute("CREATE TABLE IF NOT EXISTS runs(ts TEXT, job TEXT, host TEXT, rc INTEGER, dur REAL)")
        c.execute("INSERT INTO runs VALUES (?,?,?,?,?)", (datetime.datetime.now(datetime.timezone.utc).isoformat(), job_id, socket.gethostname(), rc, dur))
        c.commit(); c.close()
    except Exception as e:
        print(f"(run history not recorded: {e})", file=sys.stderr)


# ---------- run store (dashboard-launched runs, spec 005) --------------------
# Records runs started from the `auto serve` dashboard. Deliberately separate
# from the `runs` table above: that one is the terse per-job history every
# `auto run` writes and is left exactly as-is, while these tables carry the
# extra state a UI needs (audit id, status, tmux session, log path).
RUN_STATUSES = ("running", "succeeded", "failed", "timed_out", "cancelled")


def _runs_db() -> Path:
    db = DATA / "state" / "runs.sqlite"
    db.parent.mkdir(parents=True, exist_ok=True)
    return db


def _ui_runs_connect():
    import sqlite3
    c = sqlite3.connect(_runs_db(), timeout=10)
    c.row_factory = sqlite3.Row
    _ui_runs_schema(c)
    return c


def _ui_runs_schema(c):
    """Create the dashboard run tables if absent. Idempotent, and never
    touches the pre-existing `runs` table."""
    c.execute("""CREATE TABLE IF NOT EXISTS ui_runs(
        audit_id     TEXT PRIMARY KEY,
        kind         TEXT NOT NULL,
        action_id    TEXT NOT NULL,
        ai_profile   TEXT,
        status       TEXT NOT NULL,
        rc           INTEGER,
        started_at   TEXT NOT NULL,
        ended_at     TEXT,
        host         TEXT NOT NULL,
        tmux_session TEXT NOT NULL,
        log_path     TEXT NOT NULL,
        note         TEXT,
        data_dir     TEXT,
        config_dir   TEXT)""")
    c.execute("CREATE INDEX IF NOT EXISTS ui_runs_started ON ui_runs(started_at DESC)")
    # Additive migration for databases created before spec 005 rev. 2. Guarded
    # by table_info so it is idempotent, and the columns are nullable so rows
    # written by rev. 1 keep loading (repo convention: additive changes only).
    have = {r[1] for r in c.execute("PRAGMA table_info(ui_runs)").fetchall()}
    for col in ("data_dir", "config_dir"):
        if col not in have:
            c.execute(f"ALTER TABLE ui_runs ADD COLUMN {col} TEXT")
    c.execute("""CREATE TABLE IF NOT EXISTS ui_run_steps(
        audit_id   TEXT NOT NULL,
        step_index INTEGER NOT NULL,
        job        TEXT NOT NULL,
        status     TEXT NOT NULL,
        started_at TEXT NOT NULL,
        ended_at   TEXT,
        rc         INTEGER,
        PRIMARY KEY (audit_id, step_index, started_at))""")
    c.commit()


def _utcnow() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def new_audit_id() -> str:
    """r-<YYYYMMDD>-<HHMMSS>-<6 hex>. Sorts chronologically as a plain string,
    stays unique for runs started within the same second, and is short enough
    to read in a log line and use as a tmux session suffix."""
    import uuid
    now = datetime.datetime.now(datetime.timezone.utc)
    return f"r-{now:%Y%m%d}-{now:%H%M%S}-{uuid.uuid4().hex[:6]}"


def status_for_rc(rc: int) -> str:
    """Map an exit code to a run status. 124 is execute_job's own timeout
    convention (see its TimeoutExpired handler), so it is surfaced as
    timed_out rather than a generic failure."""
    if rc == 0:
        return "succeeded"
    return "timed_out" if rc == 124 else "failed"


def create_run(audit_id: str, kind: str, action_id: str, ai_profile: str,
               tmux_session: str, log_path: str):
    c = _ui_runs_connect()
    c.execute("INSERT INTO ui_runs(audit_id, kind, action_id, ai_profile, status, rc,"
              " started_at, ended_at, host, tmux_session, log_path, note,"
              " data_dir, config_dir)"
              " VALUES (?,?,?,?,'running',NULL,?,NULL,?,?,?,NULL,?,?)",
              (audit_id, kind, action_id, ai_profile or None, _utcnow(),
               socket.gethostname(), tmux_session, log_path,
               str(DATA), str(CONFIG_DIR)))
    c.commit(); c.close()


def finish_run(audit_id: str, rc: int, status: str | None = None, note: str | None = None):
    c = _ui_runs_connect()
    c.execute("UPDATE ui_runs SET status=?, rc=?, ended_at=?, note=COALESCE(?, note)"
              " WHERE audit_id=?",
              (status or status_for_rc(rc), rc, _utcnow(), note, audit_id))
    c.commit(); c.close()


def set_run_status(audit_id: str, status: str, note: str | None = None):
    c = _ui_runs_connect()
    c.execute("UPDATE ui_runs SET status=?, ended_at=?, note=COALESCE(?, note)"
              " WHERE audit_id=?", (status, _utcnow(), note, audit_id))
    c.commit(); c.close()


def get_run(audit_id: str) -> dict | None:
    c = _ui_runs_connect()
    row = c.execute("SELECT * FROM ui_runs WHERE audit_id=?", (audit_id,)).fetchone()
    c.close()
    return dict(row) if row else None


def list_runs(limit: int = 200) -> list[dict]:
    c = _ui_runs_connect()
    rows = c.execute("SELECT * FROM ui_runs ORDER BY started_at DESC, rowid DESC LIMIT ?",
                     (limit,)).fetchall()
    c.close()
    return [dict(r) for r in rows]


def get_run_steps(audit_id: str) -> list[dict]:
    c = _ui_runs_connect()
    rows = c.execute("SELECT * FROM ui_run_steps WHERE audit_id=? ORDER BY step_index, started_at",
                     (audit_id,)).fetchall()
    c.close()
    return [dict(r) for r in rows]


def record_step(audit_id: str, step_index: int, job: str, event: str, rc: int | None = None):
    """Upsert a step row from a marker emitted by execute_job under a
    dashboard run (see AUTO_RUN_AUDIT_ID in execute_job)."""
    c = _ui_runs_connect()
    if event == "start":
        c.execute("INSERT OR REPLACE INTO ui_run_steps(audit_id, step_index, job, status,"
                  " started_at, ended_at, rc) VALUES (?,?,?, 'running', ?, NULL, NULL)",
                  (audit_id, step_index, job, _utcnow()))
    else:
        c.execute("UPDATE ui_run_steps SET status=?, ended_at=?, rc=?"
                  " WHERE audit_id=? AND step_index=?",
                  ("succeeded" if rc == 0 else "failed", _utcnow(), rc, audit_id, step_index))
    c.commit(); c.close()


def reconcile_running_runs() -> int:
    """Move any run that claims to be running but whose tmux session is gone to
    a definite status (spec FR-016).

    The normal path never needs this — `_exec-run` records the real outcome
    itself. This only catches abnormal endings: the session killed out of band,
    the machine sleeping, or the dashboard restarting mid-run. Liveness comes
    from tmux rather than a stored PID so a recycled PID can't read as alive.
    """
    fixed = 0
    for r in list_runs(limit=500):
        if r["status"] != "running":
            continue
        if tmux_has_session(r["tmux_session"]):
            continue
        set_run_status(r["audit_id"], "failed",
                       note="ended abnormally — tmux session disappeared without recording an exit code")
        fixed += 1
    return fixed


# ---------- run logs ---------------------------------------------------------
def run_log_path(audit_id: str) -> Path:
    p = WS / "logs" / "runs" / f"{audit_id}.log"
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


def format_log_line(audit_id: str, text: str) -> str:
    """'<ISO-8601 UTC> <audit_id> <text>' — the audit id on EVERY line is what
    keeps concurrent runs disambiguable when logs are grepped together."""
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    return f"{ts} {audit_id} {text.rstrip()}\n"


def read_log_slice(path: Path, offset: int = 0) -> tuple[str, int, int]:
    """Return (text, next_offset, size) starting at a byte offset — the
    primitive the browser polls for live tailing. A missing file or an offset
    past EOF yields empty text rather than raising, so a poll that races the
    first write is harmless."""
    try:
        size = path.stat().st_size
    except FileNotFoundError:
        return "", offset, 0
    if offset >= size:
        return "", size, size
    with open(path, "rb") as f:
        f.seek(offset)
        chunk = f.read(size - offset)
    return chunk.decode("utf-8", errors="replace"), size, size


# ---------- tmux runner ------------------------------------------------------
# Every dashboard run gets its own detached tmux session. tmux's default
# remain-on-exit=off means the session disappears by itself the moment the
# command exits, which is exactly the "delete the session after the run"
# requirement — no reaper needed on the normal path.
def tmux_bin() -> str | None:
    return shutil.which("tmux")


def tmux_available() -> bool:
    return tmux_bin() is not None


def tmux_session_name(audit_id: str) -> str:
    return f"auto-{audit_id}"


def tmux_has_session(name: str) -> bool:
    tb = tmux_bin()
    if not tb:
        return False
    return subprocess.run([tb, "has-session", "-t", name],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def tmux_kill_session(name: str) -> bool:
    tb = tmux_bin()
    if not tb:
        return False
    return subprocess.run([tb, "kill-session", "-t", name],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def tmux_launch(name: str, argv: list[str], cwd: Path, env: dict | None = None) -> None:
    """Start argv in a new detached tmux session.

    CRITICAL: stdin is redirected from /dev/null. tmux allocates a real PTY per
    pane, which would make the packs' isInteractive() check (stdin is a char
    device) return true — so a job like gmail-categorize would stop at an
    interactive prompt that no browser user can answer and hang until it timed
    out. Redirecting stdin puts dashboard runs on exactly the same path those
    features already take on an unattended cron run. Do not remove this.
    """
    tb = tmux_bin()
    if not tb:
        raise RuntimeError("tmux is not installed")
    inner = " ".join(shlex.quote(a) for a in argv) + " < /dev/null"
    cmd = [tb, "new-session", "-d", "-s", name, "-c", str(cwd), inner]
    full_env = {**os.environ, **(env or {})}
    r = subprocess.run(cmd, env=full_env, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"tmux failed to start session {name}: {r.stderr.strip()}")


# ---------- action catalog (what the dashboard offers as buttons) ------------
# Rebuilt from source on every request, so a newly added job or orchestration
# shows up with no registration step — same "never drift" rule as auto list /
# catalog / the read-only dashboard sections.
#
# Commands deliberately excluded: `new` (prompts for every field), `log`
# (needs free text), `share`/`search` (need an argument). They aren't
# meaningfully "one-click".
COMMAND_ACTIONS = [
    {"id": "list",     "argv": ["list"],           "name": "List jobs",
     "description": "Every job visible across all mounted packs, with pack and visibility.",
     "danger": False},
    {"id": "packs",    "argv": ["packs"],          "name": "List packs",
     "description": "Which packs are mounted, their paths and default visibility.",
     "danger": False},
    {"id": "doctor",   "argv": ["doctor"],         "name": "Validate workspace",
     "description": "Check manifests and enforce private/shared/public visibility rules.",
     "danger": False},
    {"id": "catalog",  "argv": ["catalog"],        "name": "Regenerate catalog",
     "description": "Rewrite CATALOG.md from the current job manifests.",
     "danger": False},
    {"id": "schedule-sync", "argv": ["schedule", "sync"], "name": "Install scheduled tasks",
     "description": "Write this machine's cron/launchd entries from the job manifests. "
                    "Modifies your machine's scheduler, outside this workspace.",
     "danger": True},
    {"id": "bootstrap", "argv": ["bootstrap"],     "name": "Bootstrap workspace",
     "description": "Initialise/update git submodules and report tool availability. "
                    "Touches the working tree.",
     "danger": True},
]


def list_ai_profiles() -> list[dict]:
    """Named AI profiles usable for a run — name and provider only.

    Credential values are never included: only the profile NAME ever reaches
    the browser or a log, exactly as `auto run --ai <name>` already works.
    *.example.yaml templates are excluded because their placeholder api_key
    would fail confusingly at run time rather than up front.
    """
    d = ai_profile_dir()
    if not d.exists():
        return []
    out = []
    for p in sorted(d.glob("*.yaml")):
        if p.name.endswith(".example.yaml"):
            continue
        name = p.stem
        try:
            prof = load_yaml(p)
            provider = str(prof.get("provider") or "").strip().lower()
            usable = bool(provider) and bool(str(prof.get("api_key") or "")) \
                and provider in ("deepseek", "claude", "anthropic")
        except Exception:
            provider, usable = "", False
        out.append({"name": name, "provider": provider, "usable": usable})
    return out


def list_actions() -> list[dict]:
    """Every launchable action: jobs, orchestrations, and safe auto commands."""
    actions = []
    mach = current_machine()

    for j in sorted(load_jobs(), key=lambda x: (x["_pack"], x.get("id", ""))):
        available, reason, note = True, None, None
        if not j["_packpath"].exists():
            available, reason = False, f"pack directory missing: {j['_pack']}"
        elif not job_runs_here(j, mach):
            # runs_on is a SCHEDULING constraint, not a manual-run permission:
            # cmd_schedule uses job_runs_here to decide what to install on this
            # machine, but cmd_run deliberately never checks it, so `auto run
            # gmail-extract` works by hand on any machine. Blocking the button
            # here would make the dashboard stricter than the CLI it wraps, so
            # this is surfaced as context rather than as an obstacle.
            ro = j.get("runs_on") or {}
            note = (f"scheduled only on {ro.get('machines', ['any'])} "
                    f"(os {ro.get('os', 'any')}) — running it here is still fine")
        actions.append({
            "kind": "job", "id": j.get("id", ""),
            "name": j.get("name") or j.get("id", ""),
            "description": (j.get("description") or "").strip(),
            "pack": j["_pack"],
            "danger": False,
            "available": available, "unavailable_reason": reason, "note": note,
        })

    for o in load_orchestrations():
        problems = validate_orchestration(o)
        actions.append({
            "kind": "orchestration", "id": o["_id"],
            "name": o.get("name") or o["_id"],
            "description": (o.get("description") or "").strip(),
            "pack": None,
            "danger": False,
            "available": not problems,
            "unavailable_reason": ("; ".join(problems) if problems else None),
            "note": None,
        })

    for c in COMMAND_ACTIONS:
        actions.append({
            "kind": "command", "id": c["id"], "name": c["name"],
            "description": c["description"], "pack": None,
            "danger": c["danger"],
            "available": True, "unavailable_reason": None, "note": None,
        })
    return actions


def find_action(kind: str, action_id: str) -> dict | None:
    for a in list_actions():
        if a["kind"] == kind and a["id"] == action_id:
            return a
    return None


# ---------- dashboard session state (spec 005 rev. 2) -----------------------
# One AI profile applies to everything launched from the dashboard, chosen in a
# single control (FR-007). Process-lifetime only: not persisted across restarts
# (spec Assumptions). A plain dict behind a lock — the server is single-operator
# and already threads requests.
SESSION = {"ai_profile": None}
SESSION_LOCK = threading.Lock()


def session_ai_profile() -> str:
    with SESSION_LOCK:
        return SESSION["ai_profile"] or ""


def set_session_ai_profile(name: str | None) -> None:
    with SESSION_LOCK:
        SESSION["ai_profile"] = name or None


class RunRefused(Exception):
    """A launch was rejected for a reason the UI should show verbatim.
    `code` maps to the HTTP status in contracts/dashboard-api.md."""
    def __init__(self, code: str, message: str, **extra):
        super().__init__(message)
        self.code = code
        self.message = message
        self.extra = extra


def action_argv(action: dict, ai_profile: str = "") -> list[str]:
    """The real CLI invocation for an action.

    Dashboard runs deliberately re-enter the actual `auto` CLI rather than
    calling execute_job() in-process, so a UI-launched run takes the identical
    path as a terminal one — including run-history recording, pack config
    linking, AI profile injection and orchestration retry/loop semantics.
    """
    if action["kind"] == "job":
        argv = ["run", action["id"]]
        if ai_profile:
            argv += ["--ai", ai_profile]
        return argv
    if action["kind"] == "orchestration":
        return ["orchestrate", action["id"]]
    spec = next((c for c in COMMAND_ACTIONS if c["id"] == action["id"]), None)
    if not spec:
        raise RunRefused("unknown_action", f"no command action '{action['id']}'")
    return list(spec["argv"])


def active_run_for(kind: str, action_id: str) -> dict | None:
    """An in-flight run of the same action, if any. Used to stop a second
    concurrent run: several jobs read-modify-write the same shared CSVs, so
    overlapping runs of one action can corrupt data."""
    reconcile_running_runs()
    for r in list_runs(limit=500):
        if r["status"] == "running" and r["kind"] == kind and r["action_id"] == action_id:
            return r
    return None


def start_run(kind: str, action_id: str, ai_profile: str = "", confirm: bool = False) -> str:
    """Validate, record, and launch a run. Returns the audit id.
    Raises RunRefused with a contract error code on any rejection."""
    if not tmux_available():
        raise RunRefused("tmux_missing",
                         "tmux is not installed — install it (macOS: brew install tmux) "
                         "and restart the dashboard.")
    action = find_action(kind, action_id)
    if not action:
        raise RunRefused("unknown_action", f"no {kind} action '{action_id}'")
    if not action["available"]:
        raise RunRefused("unavailable", action["unavailable_reason"] or "action is unavailable")
    # Enforced server-side so the UI dialog can't be bypassed by posting directly.
    if action["danger"] and not confirm:
        raise RunRefused("confirm_required",
                         f"'{action['name']}' changes state outside this workspace "
                         f"and needs explicit confirmation.")
    existing = active_run_for(kind, action_id)
    if existing:
        raise RunRefused("already_running",
                         f"'{action['name']}' is already running as {existing['audit_id']}.",
                         audit_id=existing["audit_id"])
    # The profile is session-wide (spec 005 rev. 2). Re-validate at launch so a
    # profile deleted or broken since selection refuses the run rather than
    # starting it with half-resolved credentials (FR-012).
    if ai_profile:
        prof = next((p for p in list_ai_profiles() if p["name"] == ai_profile), None)
        if not prof or not prof["usable"]:
            raise RunRefused("unknown_profile",
                             f"AI profile '{ai_profile}' is not available or has "
                             f"incomplete credentials; the run was not started.")

    audit_id = new_audit_id()
    session = tmux_session_name(audit_id)
    log_path = run_log_path(audit_id)
    rel_log = str(log_path.relative_to(WS))
    create_run(audit_id, kind, action_id, ai_profile, session, rel_log)
    try:
        tmux_launch(session,
                    [sys.executable, "-u", str(Path(__file__).resolve()), "_exec-run", audit_id,
                     "--data-dir", str(DATA), "--config-dir", str(CONFIG_DIR)],
                    WS,
                    {"AUTO_WORKSPACE": str(WS), "PYTHONUNBUFFERED": "1"})
    except Exception as e:
        finish_run(audit_id, 1, status="failed", note=f"failed to start: {e}")
        raise RunRefused("launch_failed", f"could not start tmux session: {e}")
    return audit_id


def cancel_run(audit_id: str) -> dict:
    r = get_run(audit_id)
    if not r:
        raise RunRefused("unknown_run", f"no run '{audit_id}'")
    if r["status"] != "running":
        raise RunRefused("not_running", f"run {audit_id} already finished ({r['status']}).")
    tmux_kill_session(r["tmux_session"])
    set_run_status(audit_id, "cancelled", note="cancelled from the dashboard")
    return get_run(audit_id)


# ---------- _exec-run (the in-tmux wrapper; internal) ------------------------
STEP_MARKER = "##AUTO-STEP##"


def cmd_exec_run(args):
    """Run one recorded action inside its tmux session, streaming every line
    into the run's audit-tagged log, then record the true exit code.

    Not advertised in the usage block: this is how the dashboard executes a
    run, not something to invoke by hand.
    """
    audit_id = args.audit_id
    r = get_run(audit_id)
    if not r:
        sys.exit(f"no run '{audit_id}'")
    action = find_action(r["kind"], r["action_id"])
    log = WS / r["log_path"]
    log.parent.mkdir(parents=True, exist_ok=True)

    if not action:
        with open(log, "a") as f:
            f.write(format_log_line(audit_id, f"!! action {r['kind']}/{r['action_id']} no longer exists"))
        finish_run(audit_id, 1, note="action no longer exists")
        sys.exit(1)

    run_data_dir = r["data_dir"] or str(DATA)
    run_config_dir = r["config_dir"] or str(CONFIG_DIR)
    # Deliberately NOT passing --ai: the session profile is injected as
    # credential env vars below, so execute_job's existing precedence
    # ({**cfg_env, **os.environ, **ai_env}) lets an orchestration step's own
    # `ai:` still win over the session default (FR-010, research §11).
    argv = ([sys.executable, "-u", str(Path(__file__).resolve())]
            + action_argv(action, "")
            + ["--data-dir", run_data_dir, "--config-dir", run_config_dir])
    ai_default = {}
    if r["ai_profile"]:
        try:
            ai_default = ai_profile_env(r["ai_profile"])
        except SystemExit:
            ai_default = {}   # already re-validated at launch; never fail the run here
    env = {**os.environ,
           **ai_default,
           "AUTO_WORKSPACE": str(WS),
           "PYTHONUNBUFFERED": "1",
           # Tells execute_job to emit step markers; unset in terminal runs, so
           # ordinary CLI output stays byte-for-byte unchanged.
           "AUTO_RUN_AUDIT_ID": audit_id}

    rc = 1
    with open(log, "a", buffering=1) as f:
        f.write(format_log_line(audit_id,
                f"=== {action['kind']} '{action['id']}'"
                + (f" (ai profile: {r['ai_profile']})" if r["ai_profile"] else "")
                + " ==="))
        try:
            proc = subprocess.Popen(argv, cwd=str(WS), env=env, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True, bufsize=1)
            for line in proc.stdout:
                if line.startswith(STEP_MARKER):
                    _handle_step_marker(audit_id, line)
                    continue
                f.write(format_log_line(audit_id, line))
            proc.wait()
            rc = proc.returncode
        except Exception as e:
            f.write(format_log_line(audit_id, f"!! runner error: {e}"))
            rc = 1
        f.write(format_log_line(audit_id, f"=== exited {rc} ==="))

    finish_run(audit_id, rc)
    sys.exit(rc)


def _handle_step_marker(audit_id: str, line: str):
    """Parse '##AUTO-STEP## idx=<n> job=<id> event=start|end [rc=<n>]'."""
    try:
        fields = dict(kv.split("=", 1) for kv in line.split()[1:] if "=" in kv)
        idx = int(fields.get("idx", "0"))
        job = fields.get("job", "")
        event = fields.get("event", "")
        rc = int(fields["rc"]) if "rc" in fields else None
        record_step(audit_id, idx, job, event, rc)
    except Exception:
        pass  # never let a malformed marker kill a run


# ---------- orchestrator (multi-step pipelines spanning packs) --------------
def load_orchestrations() -> list[dict]:
    """Every orchestrator/*.yaml, parsed. Each gets '_id' (filename stem, the
    name used on the CLI) and '_path'. Missing/empty orchestrator/ -> []."""
    if not ORCH_DIR.exists():
        return []
    out = []
    for p in sorted(ORCH_DIR.glob("*.yaml")):
        try:
            o = load_yaml(p)
        except Exception as e:
            print(f"! bad orchestration {p}: {e}", file=sys.stderr); continue
        o = o or {}
        o["_id"] = p.stem
        o["_path"] = p
        out.append(o)
    return out

def load_orchestration(name: str) -> dict | None:
    """Parse orchestrator/<name>.yaml, or None if it doesn't exist."""
    p = ORCH_DIR / f"{name}.yaml"
    if not p.exists():
        return None
    o = load_yaml(p) or {}
    o["_id"] = name
    o["_path"] = p
    return o

def validate_orchestration(orch: dict) -> list[str]:
    """Structural validation only — no step executes here. Returns a list of
    human-readable problems; empty list means valid (FR-006)."""
    problems = []
    steps = orch.get("steps")
    if not isinstance(steps, list) or not steps:
        problems.append("orchestration must have a non-empty 'steps' list")
        return problems
    job_ids = {j["id"] for j in load_jobs()}
    for i, step in enumerate(steps):
        if not isinstance(step, dict) or not step.get("job"):
            problems.append(f"step {i}: missing required 'job'")
            continue
        if step["job"] not in job_ids:
            problems.append(f"step {i}: unknown job id '{step['job']}'  (see: auto list)")
        for field in ("retry", "timeout_seconds", "wait_before_seconds"):
            v = step.get(field)
            if v is not None and (not isinstance(v, int) or isinstance(v, bool) or v <= 0):
                problems.append(f"step {i}: '{field}' must be a positive integer, got {v!r}")
        rds = step.get("retry_delay_seconds")
        if rds is not None and (not isinstance(rds, int) or isinstance(rds, bool) or rds < 0):
            problems.append(f"step {i}: 'retry_delay_seconds' must be a non-negative integer, got {rds!r}")
        loop = step.get("loop")
        if loop is not None:
            if not isinstance(loop, dict) or "max_iterations" not in loop:
                problems.append(f"step {i}: 'loop' requires 'max_iterations'")
            else:
                mi = loop.get("max_iterations")
                if not isinstance(mi, int) or isinstance(mi, bool) or mi <= 0:
                    problems.append(f"step {i}: 'loop.max_iterations' must be a positive integer, got {mi!r}")
                uec = loop.get("until_exit_code")
                if uec is not None and (not isinstance(uec, int) or isinstance(uec, bool)):
                    problems.append(f"step {i}: 'loop.until_exit_code' must be an integer, got {uec!r}")
    return problems

def _orchestrations_db() -> Path:
    db = DATA / "state" / "orchestrations.sqlite"
    db.parent.mkdir(parents=True, exist_ok=True)
    return db

def _orchestrations_schema(c):
    c.execute("""CREATE TABLE IF NOT EXISTS orchestration_runs(
        id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT, orchestration TEXT,
        host TEXT, rc INTEGER, dur REAL)""")
    c.execute("""CREATE TABLE IF NOT EXISTS orchestration_steps(
        run_id INTEGER, step_index INTEGER, job TEXT, iteration INTEGER,
        attempt INTEGER, rc INTEGER, dur REAL, outcome TEXT)""")

def _record_orchestration_run(orch_id: str, rc: int, dur: float) -> int:
    try:
        import sqlite3
        c = sqlite3.connect(_orchestrations_db())
        _orchestrations_schema(c)
        cur = c.execute("INSERT INTO orchestration_runs(ts, orchestration, host, rc, dur) VALUES (?,?,?,?,?)",
                         (datetime.datetime.now(datetime.timezone.utc).isoformat(), orch_id, socket.gethostname(), rc, dur))
        run_id = cur.lastrowid
        c.commit(); c.close()
        return run_id
    except Exception as e:
        print(f"(orchestration run history not recorded: {e})", file=sys.stderr)
        return -1

def _record_orchestration_step(run_id: int, step_index: int, job: str, iteration: int,
                                attempt: int, rc: int, dur: float, outcome: str):
    try:
        import sqlite3
        c = sqlite3.connect(_orchestrations_db())
        _orchestrations_schema(c)
        c.execute("INSERT INTO orchestration_steps VALUES (?,?,?,?,?,?,?,?)",
                  (run_id, step_index, job, iteration, attempt, rc, dur, outcome))
        c.commit(); c.close()
    except Exception as e:
        print(f"(orchestration step history not recorded: {e})", file=sys.stderr)

def _run_step_once_with_retry(step: dict) -> tuple[int, list[tuple]]:
    """Run one loop iteration of a step, retrying up to step['retry']
    additional times on failure. Returns (final_rc, attempts) where each
    attempt is (attempt_index, rc, dur, outcome)."""
    retry = step.get("retry") or 0
    retry_delay = step.get("retry_delay_seconds") or 0
    timeout_override = step.get("timeout_seconds")
    until_code = (step.get("loop") or {}).get("until_exit_code")
    attempts = []
    rc = None
    for attempt in range(retry + 1):
        rc, dur = execute_job(step["job"], step.get("args") or [], step.get("ai", ""), timeout_override)
        if rc == 0:
            outcome = "succeeded"
        elif until_code is not None and rc == until_code:
            outcome = "loop_stopped"
        elif rc == 124:
            outcome = "timed_out"
        elif attempt < retry:
            outcome = "retried"
        else:
            outcome = "failed"
        attempts.append((attempt, rc, dur, outcome))
        if outcome in ("succeeded", "loop_stopped"):
            break
        if attempt < retry:
            if retry_delay:
                time.sleep(retry_delay)
            continue
        break
    return rc, attempts

def _run_step_with_loop(step_index: int, step: dict) -> tuple[int, list[tuple]]:
    """Run a step through its loop iterations (1 iteration if no 'loop' is
    declared), each wrapped in the retry logic above. Returns (final_rc,
    step_records), step_records being flat (step_index, job, iteration,
    attempt, rc, dur, outcome) tuples ready for _record_orchestration_step."""
    loop_cfg = step.get("loop")
    max_iter = loop_cfg["max_iterations"] if loop_cfg else 1
    job = step["job"]
    step_records = []
    final_rc = 0
    step_succeeded = True
    for iteration in range(max_iter):
        rc, attempts = _run_step_once_with_retry(step)
        for (attempt, a_rc, a_dur, outcome) in attempts:
            step_records.append((step_index, job, iteration, attempt, a_rc, a_dur, outcome))
        final_rc = rc
        last_outcome = attempts[-1][3]
        if last_outcome == "loop_stopped":
            break
        if last_outcome != "succeeded":
            step_succeeded = False
            break
    return (0 if step_succeeded else (final_rc or 1)), step_records

def _print_orchestrations():
    orchs = load_orchestrations()
    if not orchs:
        print("no orchestrations yet — add a YAML file to orchestrator/"); return
    w = max((len(o["_id"]) for o in orchs), default=2)
    for o in sorted(orchs, key=lambda x: x["_id"]):
        steps = o.get("steps") or []
        desc = o.get("description") or o.get("name") or ""
        print(f"{o['_id']:<{w}}  {len(steps)} step(s)   {desc}")

def cmd_orchestrate(args):
    if not args.name:
        _print_orchestrations()
        return

    orch = load_orchestration(args.name)
    if orch is None:
        sys.exit(f"no orchestration '{args.name}'  (looked for {(ORCH_DIR / (args.name + '.yaml')).relative_to(WS)})")
    problems = validate_orchestration(orch)
    if problems:
        print(f"orchestration '{args.name}' is invalid:")
        for p in problems:
            print(f"  - {p}")
        sys.exit(2)

    steps = orch["steps"]
    all_records = []   # (step_index, job, iteration, attempt, rc, dur, outcome)
    overall_rc = 0
    failed_at = None
    start = datetime.datetime.now()
    for i, step in enumerate(steps):
        if failed_at is not None:
            all_records.append((i, step["job"], 0, 0, -1, 0.0, "skipped"))
            continue
        wait = step.get("wait_before_seconds") or 0
        if wait:
            print(f"   (wait) sleeping {wait}s before step {i} ({step['job']})")
            time.sleep(wait)
        rc, step_records = _run_step_with_loop(i, step)
        all_records.extend(step_records)
        if rc != 0:
            failed_at = i
            overall_rc = rc

    dur_total = (datetime.datetime.now() - start).total_seconds()
    run_id = _record_orchestration_run(orch["_id"], overall_rc, dur_total)
    for step_index, job, iteration, attempt, rc, dur, outcome in all_records:
        _record_orchestration_step(run_id, step_index, job, iteration, attempt, rc, dur, outcome)

    status = "OK" if overall_rc == 0 else f"FAILED at step {failed_at}"
    print(f"\norchestration '{orch['_id']}' — {status}  ({dur_total:.1f}s)")
    for step_index, job, iteration, attempt, rc, dur, outcome in all_records:
        print(f"  step {step_index} {job:<24} iter={iteration} attempt={attempt} rc={rc:<5} {outcome}")
    sys.exit(overall_rc)


def cmd_new(args):
    packs = [p for p in load_packs() if p.get("writable")]
    if not packs:
        sys.exit("no writable packs in packs.yaml")
    print("Which pack?  " + ", ".join(f"{i}:{p['name']}({pack_default_vis(p)})" for i, p in enumerate(packs)))
    pack = packs[int((input("  pack [0]: ").strip() or "0"))]
    jid = input("  id (kebab-case): ").strip()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", jid or ""):
        sys.exit("id must be kebab-case")
    if any(j["id"] == jid for j in load_jobs()):
        sys.exit(f"id '{jid}' already exists in another pack")
    cat = input("  category [uncategorized]: ").strip() or "uncategorized"
    name = input("  name: ").strip() or jid
    lang = input("  language [python/bash/node/go]: ").strip() or "python"
    dest = pack["_path"] / "jobs" / cat / jid
    if dest.exists():
        sys.exit(f"{dest} already exists")
    dest.mkdir(parents=True)
    ext = {"python": "py", "bash": "sh", "node": "js", "go": "go"}.get(lang, "sh")
    entry = f"main.{ext}"
    (dest / entry).write_text("#!/usr/bin/env bash\nset -euo pipefail\necho hi\n" if lang == "bash" else f"# {name}\n")
    m = load_yaml(FRAMEWORK / "template" / "manifest.yaml")
    m.update({"id": jid, "name": name, "category": cat, "language": lang,
              "entrypoint": entry, "visibility": pack_default_vis(pack)})
    with open(dest / "manifest.yaml", "w") as f:
        yaml.safe_dump(m, f, sort_keys=False)
    shutil.copy(FRAMEWORK / "template" / "README.md", dest / "README.md")
    print(f"created {dest.relative_to(WS)}\n  edit manifest + {entry}, then:  ./auto run {jid}")

def _catalog_rows(jobs):
    rows = ["| id | name | pack | visibility | lang | schedule | machines |",
            "|----|------|------|-----------|------|----------|----------|"]
    for j in sorted(jobs, key=lambda x: (x["_pack"], x.get("category", ""), x.get("id", ""))):
        sch = j.get("schedule") or {}
        when = f"`{sch.get('cron')}`" if sch.get("enabled") and sch.get("cron") else "manual"
        mc = ", ".join((j.get("runs_on") or {}).get("machines", ["any"]))
        rows.append(f"| {j.get('id')} | {j.get('name','')} | {j['_pack']} | {j['_visibility']} | {j.get('language','')} | {when} | {mc} |")
    return rows

