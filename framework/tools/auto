function esc(s) {{
  const d = document.createElement('div'); d.textContent = s == null ? '' : s;
  return d.innerHTML;
}}

async function launch(kind, id, danger) {{
  // Server enforces this too (a confirm-less POST is rejected) — the dialog is
  // the friendly half of the same gate.
  if (danger && !confirm('This changes state outside the workspace (your machine\\'s scheduler or working tree).\\n\\nRun it anyway?')) return;
  const payload = {{ kind, id, confirm: !!danger }};
  const {{ ok, body }} = await api('/api/runs', {{
    method: 'POST', headers: {{ 'Content-Type': 'application/json' }},
    body: JSON.stringify(payload)
  }});
  if (!ok) {{ toast(body.message || 'could not start the run'); await loadRuns(); return; }}
  toast(`started ${{body.audit_id}}`);
  await loadRuns();
  openRun(body.audit_id);
}}

// ---- runs ----
async function loadRuns() {{
  const {{ body }} = await api('/api/runs');
  const runs = body.runs || [];
  if (!runs.length) {{ $('runs').innerHTML = '<em>nothing has been run yet</em>'; return; }}
  $('runs').innerHTML = '<table><tr><th>action</th><th>audit id</th><th>started</th>' +
    '<th>elapsed</th><th>ai</th><th>status</th><th></th></tr>' +
    runs.map(r => `<tr>
      <td>${{esc(r.action_id)}} <span class="tag">${{r.kind}}</span></td>
      <td><a href="#" class="aid" onclick="openRun('${{r.audit_id}}');return false">${{r.audit_id}}</a></td>
      <td>${{esc(r.started_at)}}</td>
      <td>${{r.elapsed_seconds == null ? '' : r.elapsed_seconds + 's'}}</td>
      <td>${{esc(r.ai_profile || '')}}</td>
      <td><span class="badge b-${{r.status}}">${{r.status}}</span></td>
      <td>${{r.status === 'running'
            ? `<button onclick="cancelRun('${{r.audit_id}}')">Cancel</button>` : ''}}</td>
    </tr>`).join('') + '</table>';
}}

async function cancelRun(aid) {{
  const {{ ok, body }} = await api(`/api/runs/${{aid}}/cancel`, {{ method: 'POST' }});
  toast(ok ? `cancelled ${{aid}}` : (body.message || 'could not cancel'));
  await loadRuns();
}}

function openRun(aid) {{
  OPEN_RUN = aid; LOG_OFFSET = 0; PINNED = true;
  $('rundetail').innerHTML = `
    <h3>Run <span class="aid">${{aid}}</span>
        <button onclick="closeRun()" style="float:right">close</button></h3>
    <div id="runmeta" class="meta"></div>
    <ul id="runsteps" class="steps"></ul>
    <pre id="logbox"></pre>`;
  $('logbox').addEventListener('scroll', () => {{
    const el = $('logbox');
    PINNED = el.scrollHeight - el.scrollTop - el.clientHeight < 40;
  }});
  if (LOG_TIMER) clearInterval(LOG_TIMER);
  pollLog();
  LOG_TIMER = setInterval(pollLog, 1000);
}}

function closeRun() {{
  OPEN_RUN = null;
  if (LOG_TIMER) clearInterval(LOG_TIMER);
  LOG_TIMER = null;
  $('rundetail').innerHTML = '';
}}

async function pollLog() {{
  if (!OPEN_RUN) return;
  const aid = OPEN_RUN;
  const meta = await api(`/api/runs/${{aid}}`);
  if (meta.ok && $('runmeta')) {{
    const r = meta.body.run;
    $('runmeta').innerHTML =
      `${{esc(r.action_id)}} · <span class="badge b-${{r.status}}">${{r.status}}</span>` +
      (r.rc == null ? '' : ` · exit ${{r.rc}}`) +
      (r.ai_profile ? ` · ai: ${{esc(r.ai_profile)}}` : '') +
      (r.note ? ` · ${{esc(r.note)}}` : '');
    const steps = meta.body.steps || [];
    $('runsteps').innerHTML = steps.map(s =>
      `<li>step ${{s.step_index}}: ${{esc(s.job)}} <span class="badge b-${{s.status}}">${{s.status}}</span></li>`
    ).join('');
  }}
  const {{ ok, body }} = await api(`/api/runs/${{aid}}/log?from=${{LOG_OFFSET}}`);
  if (!ok || OPEN_RUN !== aid) return;
  if (body.text) {{
    const box = $('logbox');
    if (!box) return;
    box.textContent += body.text;
    // Keep the rendered buffer bounded so a very chatty run can't freeze the page.
    if (box.textContent.length > 400000) box.textContent = box.textContent.slice(-300000);
    if (PINNED) box.scrollTop = box.scrollHeight;
  }}
  LOG_OFFSET = body.next;
  if (body.eof) {{ clearInterval(LOG_TIMER); LOG_TIMER = null; await loadRuns(); }}
}}

loadActions();
loadRuns();
setInterval(loadRuns, 4000);
</script>
</body></html>"""

# Error code -> HTTP status, per contracts/dashboard-api.md.
REFUSAL_STATUS = {
    "unknown_action": 404, "unknown_run": 404,
    "already_running": 409, "not_running": 409,
    "confirm_required": 412, "unavailable": 422,
    "tmux_missing": 503, "launch_failed": 500,
}

ALLOWED_HOSTS = ("127.0.0.1", "localhost", "::1", "[::1]")


def _host_allowed(host_header: str | None) -> bool:
    """Only accept requests addressed to a loopback host.

    This is the DNS-rebinding defense: a malicious page can point its own
    hostname at 127.0.0.1 and POST here, but it cannot change the Host header
    it sends. ADR 0012 could skip this because nothing was executable; now
    that runs can be launched, it matters.
    """
    if not host_header:
        return False
    h = host_header.rsplit(":", 1)[0] if not host_header.startswith("[") else host_header.split("]")[0] + "]"
    return h in ALLOWED_HOSTS


def cmd_serve(args):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    class Handler(BaseHTTPRequestHandler):
        # ---- helpers ----
        def _json(self, status, payload):
            body = json.dumps(payload).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _err(self, status, code, message, **extra):
            self._json(status, {"error": code, "message": message, **extra})

        def _guard(self) -> bool:
            if not _host_allowed(self.headers.get("Host")):
                self._err(403, "forbidden_host",
                          "This dashboard only accepts requests addressed to localhost.")
                return False
            return True

        def _body(self) -> dict:
            n = int(self.headers.get("Content-Length") or 0)
            if not n:
                return {}
            try:
                return json.loads(self.rfile.read(n).decode("utf-8"))
            except Exception:
                return {}

        def _run_payload(self, r: dict) -> dict:
            started = r["started_at"]
            try:
                t0 = datetime.datetime.strptime(started, "%Y-%m-%dT%H:%M:%SZ").replace(
                    tzinfo=datetime.timezone.utc)
                end = (datetime.datetime.strptime(r["ended_at"], "%Y-%m-%dT%H:%M:%SZ").replace(
                    tzinfo=datetime.timezone.utc) if r["ended_at"]
                    else datetime.datetime.now(datetime.timezone.utc))
                elapsed = round((end - t0).total_seconds(), 1)
            except Exception:
                elapsed = None
            return {**r, "elapsed_seconds": elapsed}

        # ---- GET: never has side effects (spec FR-029) ----
        def do_GET(self):
            if not self._guard():
                return
            u = urlparse(self.path)
            path, qs = u.path, parse_qs(u.query)

            if path == "/":
                body = _dashboard_html().encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return

            if path == "/api/actions":
                self._json(200, {"tmux_available": tmux_available(),
                                 "session": {"ai_profile": session_ai_profile() or None,
                                             "data_dir": str(DATA),
                                             "config_dir": str(CONFIG_DIR)},
                                 "ai_profiles": list_ai_profiles(),
                                 "actions": list_actions()})
                return

            if path == "/api/runs":
                reconcile_running_runs()
                self._json(200, {"runs": [self._run_payload(r) for r in list_runs()]})
                return

            m = re.fullmatch(r"/api/runs/([^/]+)", path)
            if m:
                r = get_run(m.group(1))
                if not r:
                    self._err(404, "unknown_run", f"no run '{m.group(1)}'"); return
                self._json(200, {"run": self._run_payload(r), "steps": get_run_steps(r["audit_id"])})
                return

            m = re.fullmatch(r"/api/runs/([^/]+)/log", path)
            if m:
                r = get_run(m.group(1))
                if not r:
                    self._err(404, "unknown_run", f"no run '{m.group(1)}'"); return
                try:
                    offset = int((qs.get("from") or ["0"])[0])
                except ValueError:
                    offset = 0
                text, nxt, size = read_log_slice(WS / r["log_path"], max(0, offset))
                # eof only when the run has finished AND the client has caught
                # up to the end of the file — otherwise it would stop polling
                # while output was still being flushed.
                eof = r["status"] != "running" and nxt >= size
                self._json(200, {"from": offset, "next": nxt, "eof": eof, "text": text})
                return

            self._err(404, "not_found", f"no such path: {path}")

        # ---- POST: every mutation lives here ----
        def do_POST(self):
            if not self._guard():
                return
            path = urlparse(self.path).path

            if path == "/api/runs":
                b = self._body()
                try:
                    # The profile comes from the session control, never the
                    # request body (spec 005 rev. 2, contracts).
                    aid = start_run(str(b.get("kind") or ""), str(b.get("id") or ""),
                                    session_ai_profile(), bool(b.get("confirm")))
                except RunRefused as e:
                    self._err(REFUSAL_STATUS.get(e.code, 400), e.code, e.message, **e.extra)
                    return
                r = get_run(aid)
                self._json(201, {"audit_id": aid, "status": r["status"], "log_path": r["log_path"]})
                return

            m = re.fullmatch(r"/api/runs/([^/]+)/cancel", path)
            if m:
                try:
                    r = cancel_run(m.group(1))
                except RunRefused as e:
                    self._err(REFUSAL_STATUS.get(e.code, 400), e.code, e.message)
                    return
                self._json(200, {"audit_id": r["audit_id"], "status": r["status"]})
                return

            self._err(404, "not_found", f"no such path: {path}")

        def do_PUT(self):
            if not self._guard():
                return
            if urlparse(self.path).path == "/api/session/ai-profile":
                b = self._body()
                name = b.get("ai_profile")
                if name:
                    prof = next((p for p in list_ai_profiles() if p["name"] == name), None)
                    if not prof or not prof["usable"]:
                        self._err(422, "unknown_profile",
                                  f"AI profile '{name}' is not available or has "
                                  f"incomplete credentials.")
                        return
                set_session_ai_profile(name)
                self._json(200, {"ai_profile": session_ai_profile() or None})
                return
            self._err(404, "not_found", f"no such path: {self.path}")

        def log_message(self, fmt, *a):
            pass  # quiet — localhost-only dashboard, polled continuously; see ADR 0018

    httpd = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    print(f"serving workspace dashboard on http://127.0.0.1:{args.port}  (Ctrl+C to stop)")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        httpd.server_close()

def cmd_bootstrap(args):
