# ---------- schedule sync ----------------------------------------------------
def cmd_schedule(args):
    if args.action != "sync":
        sys.exit("usage: auto schedule sync [--dry-run]")
    mach = current_machine(); osname = this_os()
    due = [j for j in load_jobs()
           if (j.get("schedule") or {}).get("enabled") and (j.get("schedule") or {}).get("cron")
           and job_runs_here(j, mach)]
    print(f"# {len(due)} scheduled job(s) for this machine ({osname})")
    {"linux": _sync_cron, "macos": _sync_launchd, "windows": _sync_windows}[osname](due, args.dry_run)

def _auto_cmd(job_id):
    """The command written into cron/launchd entries.

    It MUST carry --data-dir/--config-dir explicitly (spec 005 rev. 2): the
    scheduler runs with a bare environment, so an entry relying on
    AUTO_DATA_DIR being exported would fail every time. Re-run
    `auto schedule sync` after upgrading so existing entries gain them.
    """
    return (f'"{sys.executable}" "{Path(__file__).resolve()}" run {job_id}'
            f' --data-dir "{DATA}" --config-dir "{CONFIG_DIR}"')

def _sync_cron(due, dry):
    a, b = "# >>> automation >>>", "# <<< automation <<<"
    block = "\n".join([a, *[f"{j['schedule']['cron']} {_auto_cmd(j['id'])}  # {j['id']}" for j in due], b])
    if dry:
        print("would install:\n" + block); return
    try:
        cur = subprocess.run(["crontab", "-l"], capture_output=True, text=True).stdout
    except Exception:
        cur = ""
    cur = re.sub(re.escape(a) + r".*?" + re.escape(b), "", cur, flags=re.S).strip()
    subprocess.run(["crontab", "-"], input=(cur + "\n\n" + block + "\n").lstrip(), text=True)
    print("crontab updated.")

def _sync_launchd(due, dry):
    GEN.mkdir(parents=True, exist_ok=True)
    for j in due:
        label = f"com.automation.{j['id']}"
        mins, hrs, *_ = (j["schedule"]["cron"].split() + ["*", "*"])[:2]
        (GEN / f"{label}.plist").write_text(textwrap.dedent(f"""\
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0"><dict>
          <key>Label</key><string>{label}</string>
          <key>ProgramArguments</key><array>
            <string>{sys.executable}</string><string>{Path(__file__).resolve()}</string>
            <string>run</string><string>{j['id']}</string></array>
          <key>StartCalendarInterval</key><dict>
            <key>Hour</key><integer>{hrs if hrs.isdigit() else 0}</integer>
            <key>Minute</key><integer>{mins if mins.isdigit() else 0}</integer></dict>
        </dict></plist>"""))
        print(f"wrote {(GEN / (label + '.plist')).relative_to(WS)}")
    if not dry:
        print("load:  cp schedules/generated/*.plist ~/Library/LaunchAgents/ && for p in ~/Library/LaunchAgents/com.automation.*; do launchctl load \"$p\"; done")

def _sync_windows(due, dry):
    GEN.mkdir(parents=True, exist_ok=True)
    lines = ["@echo off", "REM Run as your user to (re)register scheduled tasks."]
    for j in due:
        mins, hrs, *_ = (j["schedule"]["cron"].split() + ["0", "0"])[:2]
        hh = int(hrs) if hrs.isdigit() else 0; mm = int(mins) if mins.isdigit() else 0
        lines.append(f'schtasks /Create /F /TN "automation\\{j["id"]}" /SC DAILY /ST {hh:02d}:{mm:02d} /TR {_auto_cmd(j["id"])}')
    (GEN / "install-tasks.bat").write_text("\r\n".join(lines) + "\r\n")
    print(f"wrote {(GEN / 'install-tasks.bat').relative_to(WS)}" + ("" if dry else " — run it to register tasks"))


def _extract_opts(argv: list[str], names: tuple[str, ...]) -> tuple[list[str], dict]:
    """Pull `--name VALUE` / `--name=VALUE` out of argv before argparse sees it
    (ADR 0015; extended for --data-dir/--config-dir in spec 005 rev. 2), so
    these never have to coexist with `run`'s own bare `--` separator inside
    argparse itself: a `nargs='*'` positional plus another named option on the
    same subparser has unreliable `--` handling across Python versions
    (verified broken on 3.10; fixed upstream in 3.13, but this script's shebang
    can't assume that). Returns (remaining argv, {name: value}); a name absent
    from argv maps to "".
    """
    found = {n: "" for n in names}
    out, i = [], 0
    while i < len(argv):
        tok = argv[i]
        matched = False
        for n in names:
            if tok == f"--{n}" and i + 1 < len(argv):
                found[n] = argv[i + 1]; i += 2; matched = True; break
            if tok.startswith(f"--{n}="):
                found[n] = tok[len(f"--{n}="):]; i += 1; matched = True; break
        if matched:
            continue
        out.append(tok); i += 1
    return out, found


def _extract_ai_flag(argv: list[str]) -> tuple[list[str], str]:
    """Back-compatible wrapper over _extract_opts for `--ai` alone."""
    out, found = _extract_opts(argv, ("ai",))
    return out, found["ai"]

# ---------- arg parsing ------------------------------------------------------
# Commands that read or write the workspace's data/config directories, or that
# launch something which will (spec 005 rev. 2, research §15). Everything else —
# list, packs, search, doctor, catalog, config, new, log, share, bootstrap —
# never resolves them, so it stays usable for diagnosing a bad configuration
# (FR-019). `schedule` is here because the entries it writes must embed the
# directories to remain self-sufficient (research §16).
DIR_REQUIRING_COMMANDS = ("run", "orchestrate", "serve", "schedule", "_exec-run")


def main():
    argv = sys.argv[1:]
    ai_name = ""
    cmd = argv[0] if argv else ""
    # Pulled out before argparse — see _extract_opts for why.
    opt_names = ["data-dir", "config-dir"] + (["ai"] if cmd == "run" else [])
    argv, opts = _extract_opts(argv, tuple(opt_names))
    ai_name = opts.get("ai", "")
    if cmd in DIR_REQUIRING_COMMANDS:
        resolve_workspace_dirs(opts["data-dir"], opts["config-dir"])

    p = argparse.ArgumentParser(prog="auto", description="automation-framework CLI")
    sub = p.add_subparsers(dest="cmd", required=True)
    lp = sub.add_parser("list"); lp.add_argument("--json", action="store_true"); lp.add_argument("--visibility", choices=VISIBILITIES)
    sub.add_parser("packs")
    sp = sub.add_parser("search"); sp.add_argument("term")
    rp = sub.add_parser("run"); rp.add_argument("id"); rp.add_argument("extra", nargs="*")
    orp = sub.add_parser("orchestrate"); orp.add_argument("name", nargs="?")
    sub.add_parser("new"); sub.add_parser("catalog"); sub.add_parser("doctor"); sub.add_parser("bootstrap")
    shp = sub.add_parser("share"); shp.add_argument("pack", nargs="?")
    lgp = sub.add_parser("log"); lgp.add_argument("message")
    scp = sub.add_parser("schedule"); scp.add_argument("action"); scp.add_argument("--dry-run", action="store_true")
    cfp = sub.add_parser("config"); cfp.add_argument("action", choices=["status", "init"], nargs="?", default="status"); cfp.add_argument("pack")
    svp = sub.add_parser("serve"); svp.add_argument("--port", type=int, default=4321)
    # Internal: how `auto serve` executes a run inside its tmux session.
    # Intentionally absent from the usage docstring — not a user-facing command.
    xrp = sub.add_parser("_exec-run"); xrp.add_argument("audit_id")
    a = p.parse_args(argv)
    a.ai = ai_name  # only meaningful for cmd == "run" (ADR 0015)
    {"list": cmd_list, "packs": cmd_packs, "search": cmd_search, "run": cmd_run, "orchestrate": cmd_orchestrate,
     "new": cmd_new, "catalog": cmd_catalog, "share": cmd_share, "log": cmd_log, "doctor": cmd_doctor,
     "bootstrap": cmd_bootstrap, "schedule": cmd_schedule, "config": cmd_config, "serve": cmd_serve,
     "_exec-run": cmd_exec_run}[a.cmd](a)

if __name__ == "__main__":
    main()
